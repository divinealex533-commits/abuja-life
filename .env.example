# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — keep secret

# Paystack → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx           # server only — keep secret
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx

# Your live site address (used for the Paystack return URL)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Comma-separated Supabase user IDs that can open /admin
ADMIN_USER_IDS=
